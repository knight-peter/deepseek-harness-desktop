# dsh-desktop 配置总览（提交进仓库）
#
# 加载顺序（后覆盖前）：.env → .env.development → .env.local
# - 本文件：共享非敏感配置（真实值）
# - .env.development：开发环境覆盖（提交）
# - .env.local（gitignore）：本机私有凭据（token/证书/Apple ID）
#
# 本机私有项模板见下方「本机私有配置（复制到 .env.local）」——⚠️ 不要在
# 本文件里填私有值，否则会随提交泄漏；复制到 .env.local 再填。
# .env.local 创建方式：cp .env.example .env.local（或手动建文件复制下方注释项）
#
# 需要凭据的脚本（build/publish-x64/install-engine 等）用 Node 原生
# `--env-file-if-exists` 按序加载，无需手动 export；CI 无 .env 文件时静默
# 跳过，继续用 GitHub secrets。shell 里已 export 的变量优先于文件值。
# `pnpm dev` 刻意不读 env 文件——日常启动零配置依赖。

# ── 共享：GitHub 发布目标 ────────────────────────────────────────────────
# electron-builder.yml 的 publish 用 ${env.GH_OWNER}/${env.GH_REPO} 宏读取；
# scripts/publish-x64.mjs 同样从这里读。改仓库时只改这里 + package.json
# 的 repository 字段，两处保持一致即可。
GH_OWNER=knight-peter
GH_REPO=deepseek-harness-desktop

# ── 共享：macOS 签名策略 ─────────────────────────────────────────────────
# 关闭自动发现：electron-builder 不再自动搜钥匙串找签名证书——本机钥匙串
# 里的公司证书不会被误用。等效于「默认不签名」；有个人证书后在 .env.local
# 填 CSC_LINK + CSC_KEY_PASSWORD 即可启用签名（见下方本机私有配置段）。
CSC_IDENTITY_AUTO_DISCOVERY=false

# ── 共享：数据目录默认值 ─────────────────────────────────────────────────
# index.ts 的 dshHome() 默认 ~/.dsh；如需全局改，取消注释
# DSH_HOME=~/.dsh

# ═════════════════════════════════════════════════════════════════════════
# 本机私有配置（复制以下项到 .env.local，取消注释并填入真实值）
# ═════════════════════════════════════════════════════════════════════════

# ── 发布到 GitHub Releases（必填）─────────────────────────────────────────
# GitHub token，用于 scripts/publish-x64.mjs 上传产物到 release。
# - 本机自用：Settings → Developer settings → Personal access tokens →
#   Fine-grained tokens，Repository access 选本项目，Permissions →
#   Contents: Read and write（唯一必需项）。
# - CI 不用配：Actions 自动注入 GITHUB_TOKEN。
# 占位符格式：github_pat_ 开头（fine-grained）或 ghp_ 开头（classic）
# GH_TOKEN=github_pat_替换成你的token

# ── macOS 签名（可选，CI 用 secrets 注入）─────────────────────────────────
# 默认不签名（共享 .env 里 CSC_IDENTITY_AUTO_DISCOVERY=false）。
# 有个人 Developer ID 证书后，本机签名 Intel dmg 的方式：
#   1. 导出证书为 p12（钥匙串访问 → 右键证书 → 导出）
#   2. 在 .env.local 填下面两项（base64：base64 -i your.p12 | tr -d '\n'）
# 启用后 `pnpm build` 自动签名；CI 通过同名 secrets 注入。
# CSC_LINK=base64编码的p12文件内容
# CSC_KEY_PASSWORD=证书密码

# ── macOS 公证（可选，CI 用 secrets 注入）─────────────────────────────────
# 三选一，配齐才公证；都没配则跳过公证（打包不失败）
# 方式 1（推荐）：App Store Connect API Key
# APPLE_API_KEY=你的APIKey内容
# APPLE_API_KEY_ID=你的KeyID
# APPLE_API_ISSUER=你的IssuerID
# 方式 2：Apple ID + App 专用密码 + Team ID
# APPLE_ID=你的AppleID邮箱
# APPLE_APP_SPECIFIC_PASSWORD=你的App专用密码
# APPLE_TEAM_ID=你的TeamID
# 方式 3：钥匙串 profile
# APPLE_KEYCHAIN=钥匙串名称
# APPLE_KEYCHAIN_PROFILE=profile名称

# ── 引擎相关（可选）───────────────────────────────────────────────────────
# 引擎来源：显式指定 dsh CLI 入口 / 指向 deepseek-harness 源码目录
# DSH_ENGINE_BIN=/绝对路径/到/dsh/bin.js
# DSH_CHECKOUT=/绝对路径/到/deepseek-harness/源码目录
