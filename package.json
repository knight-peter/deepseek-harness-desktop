{
  "name": "dsh-desktop",
  "version": "0.1.6",
  "description": "Electron shell hosting the DeepSeek Harness web UI (dsh web) under Electron's embedded Node",
  "author": "Knight-peter",
  "license": "MIT",
  "private": true,
  "repository": "https://github.com/knight-peter/deepseek-harness-desktop.git",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "pnpm run compile && electron .",
    "compile": "tsc -p tsconfig.json && node scripts/copy-static.mjs",
    "build": "pnpm run compile && node --env-file-if-exists=.env --env-file-if-exists=.env.development --env-file-if-exists=.env.local node_modules/electron-builder/out/cli/cli.js --config electron-builder.config.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "install-engine": "node --env-file-if-exists=.env --env-file-if-exists=.env.development --env-file-if-exists=.env.local scripts/install-engine.mjs",
    "rebuild-engine": "node --env-file-if-exists=.env --env-file-if-exists=.env.development --env-file-if-exists=.env.local scripts/rebuild-engine.mjs",
    "smoke": "node --env-file-if-exists=.env --env-file-if-exists=.env.development --env-file-if-exists=.env.local scripts/smoke.mjs",
    "engine-update": "node --env-file-if-exists=.env --env-file-if-exists=.env.development --env-file-if-exists=.env.local scripts/engine-update.mjs",
    "publish-release": "node --env-file-if-exists=.env --env-file-if-exists=.env.development --env-file-if-exists=.env.local scripts/publish-release.mjs",
    "sync-domestic": "node --env-file-if-exists=.env --env-file-if-exists=.env.development --env-file-if-exists=.env.local scripts/sync-domestic.mjs",
    "download-release": "node scripts/download-release.mjs",
    "sign-cert": "node scripts/make-self-signed-cert.mjs",
    "release": "node scripts/bump-version.mjs",
    "release-all": "node --env-file-if-exists=.env --env-file-if-exists=.env.development --env-file-if-exists=.env.local scripts/release-all.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "js-yaml": "^4.1.0",
    "pnpm": "^10.33.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "electron": "43.4.0",
    "electron-builder": "^26.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
