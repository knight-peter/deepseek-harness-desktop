{
  "name": "dsh-desktop",
  "version": "0.1.0",
  "description": "Electron shell hosting the DeepSeek Harness web UI (dsh web) under Electron's embedded Node",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "pnpm run build && electron .",
    "build": "tsc -p tsconfig.json && node scripts/copy-static.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "pack": "pnpm run build && electron-builder"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "43.4.0",
    "electron-builder": "^26.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
