{
  "name": "dsh-desktop",
  "version": "0.1.0",
  "description": "Electron shell hosting the DeepSeek Harness web UI (dsh web) under Electron's embedded Node",
  "author": "dsh-desktop",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "pnpm run build && electron .",
    "build": "tsc -p tsconfig.json && node scripts/copy-static.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "install-engine": "node scripts/install-engine.mjs",
    "rebuild-engine": "node scripts/rebuild-engine.mjs",
    "smoke": "node scripts/smoke.mjs",
    "pack": "pnpm run build && electron-builder"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "js-yaml": "^4.1.0",
    "pnpm": "^11.22.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "electron": "43.4.0",
    "electron-builder": "^26.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
